{
  "name": "hotcell",
  "version": "0.1.33",
  "description": "Sandboxes for AI agents, on your own hardware — CLI + daemon for the hotcell sandbox platform",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hotcell": "dist/index.js",
    "hc": "dist/index.js",
    "hotcelld": "dist/daemon.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/index.ts",
    "prepack": "cp ../../README.md ./README.md && chmod +x dist/index.js dist/daemon.js"
  },
  "dependencies": {
    "@hotcell/daemon": "0.1.33",
    "@hotcell/sdk": "0.1.33"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/directionally-local/hotcell.git"
  },
  "homepage": "https://directionallylocal.com/hotcell/",
  "bugs": {
    "url": "https://github.com/directionally-local/hotcell/issues"
  },
  "keywords": [
    "sandbox",
    "ai-agents",
    "firecracker",
    "microvm",
    "apple-virtualization",
    "code-execution",
    "llm-gateway",
    "self-hosted"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
